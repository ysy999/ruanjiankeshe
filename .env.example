# Copy to backend/.env and replace local credentials and API keys.
APP_NAME=ruanjiankeshe
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/ai_cs?charset=utf8mb4
LLM_PROVIDER=deepseek
LLM_API_KEY=replace-with-your-deepseek-api-key
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=sk-replace-with-your-embedding-api-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIM=1024
# Volcengine Ark embedding: EMBEDDING_PROVIDER=volcengine,
# EMBEDDING_MODEL=<model ID or endpoint ID>,
# EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3,
# EMBEDDING_API_KEY=<your Ark key>
# Optional legacy alias for DashScope:
DASHSCOPE_API_KEY=
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
CORS_ORIGINS=http://localhost:5173
# Optional comma-separated URLs; leave empty to disable web-source crawling.
WEB_SOURCES=
